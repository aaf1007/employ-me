1c:T61a,data:image/png;base64,:T6ca,data:image/png;base64,:T5fe,data:image/png;base64,:T876,data:image/png;base64,:["$","$L1b",null,{"data":{"seo":{"description":"Autonomous Uncrewed Combat Aerial Vehicle.","ogImage":{"_type":"image","asset":{"_ref":"image-709394a323c20916569e85f13d011fe8ac0778ef-1200x660-png","_type":"reference"}},"title":"CA-1 Europa "},"slide1":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-9410d7e7867e67f56c6e65bf2e08456186b54f23-4320x2706-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5964523281596452,"height":2706,"width":4320},"filename":"9410d7e7867e67f56c6e65bf2e08456186b54f23-4320x2706.png","hotspot":null,"lqip":"data:image/png;base64,"},"bgImageLandscapeIntersected":{"_type":"image","alt":"","asset":{"_ref":"image-3f22bc3eee40b7fce56b1ef63aa9da3cdea82575-4320x2706-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5964523281596452,"height":2706,"width":4320},"filename":"3f22bc3eee40b7fce56b1ef63aa9da3cdea82575-4320x2706.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-a10a25aa1a96c79844e0cd352e64ebebfae03c70-1170x2532-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.46208530805687204,"height":2532,"width":1170},"filename":"a10a25aa1a96c79844e0cd352e64ebebfae03c70-1170x2532.png","hotspot":null,"lqip":"data:image/png;base64,"},"bgImagePortraitIntersected":{"_type":"image","alt":"","asset":{"_ref":"image-86cbbb322af765fc0f40aca11dede5b008e94f94-1170x2532-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.46208530805687204,"height":2532,"width":1170},"filename":"86cbbb322af765fc0f40aca11dede5b008e94f94-1170x2532.png","hotspot":null,"lqip":"$1c"},"text1":"CA-1 Europa\nAutonomous Uncrewed Combat Aerial Vehicle","texts":[{"text":"CA-1 Europa is an autonomous fighter jet in the three-to-five ton class under development at Helsing and its subsidiary Grob Aircraft. Combining the Centaur AI software and mission stack with Grob's proven capability in aircraft design and manufacturing, CA-1 represents a clean-slate approach to air dominance. Helsing is working with leading partners in the European aerospace ecosystem to build the aircraft, with a focus on scalability and a resilient supply and logistics chain.","title":"A NEW CHAPTER IN AIR DOMINANCE"}]},"slide2":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-f78c9bd4246b172746af43ad78fd60b821d76f0f-2880x1618-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7799752781211373,"height":1618,"width":2880},"filename":"f78c9bd4246b172746af43ad78fd60b821d76f0f-2880x1618.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-d61bdba8766c7edabc23e8d2b1795fccb7d0b0e1-1170x1626-png","_type":"reference"},"crop":{"_type":"sanity.imageCrop","bottom":0,"left":0,"right":0,"top":0.27784405213253727},"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.7195571955719557,"height":1626,"width":1170},"filename":"d61bdba8766c7edabc23e8d2b1795fccb7d0b0e1-1170x1626.png","hotspot":{"_type":"sanity.imageHotspot","height":0.6920447698038381,"width":1,"x":0.5,"y":0.6539776150980809},"lqip":"$1d"},"texts":null},"slide3":{"texts":[{"text":"CA-1 Europa is tailored to the requirements of intelligent mass. The platform combines a mass-produceable airframe with powerful but affordable payload and advanced AI for situational awareness and mission execution. It is configured to complete missions as a single asset or as part of a swarm.","title":"MULTI-ROLE MASS PRODUCABLE"}],"videoLandscape":{"360":"1de3a9276ba71cb20a2bd391f0cc615c000f6213.mp4","720":"1de3a9276ba71cb20a2bd391f0cc615c000f6213.mp4","1080":"1de3a9276ba71cb20a2bd391f0cc615c000f6213.mp4"},"videoPortrait":{"360":"1aeac0810a63ba538bae7ad65e1d98eb5fcdc4f3.mp4","720":"1aeac0810a63ba538bae7ad65e1d98eb5fcdc4f3.mp4","1080":"1aeac0810a63ba538bae7ad65e1d98eb5fcdc4f3.mp4"}},"slide4":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-5d0eb0357e6b58d9d88861bc6a755d4ef0d2f36b-4096x1940-jpg","_type":"reference"}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-5d0eb0357e6b58d9d88861bc6a755d4ef0d2f36b-4096x1940-jpg","_type":"reference"}},"texts":[{"text":"CA-1 is engineered for fully autonomous operations in contested and denied environments. Leveraging Helsing's Centaur AI pilot stack and advanced mission systems, the platform will deliver precise effects across a range of mission profiles. Its modular architecture is designed to enable rapid capability evolution and integration of emerging threats.","title":"AI AT THE CORE"},{"text":"CA-1 Europa will be deployable in large numbers for extended, high-tempo engagements. Designed to offer affordable, high-end force projection, the platform is optimised for dispersed logistics and operations from improvised locations with minimal infrastructure. The modular air frame allows for rapid integration of new sensors, self-protection systems, electronic warfare equipment and effector capabilities.","title":"FLEXIBLE AND SUSTAINABLE MASS"},{"text":"With its focus on sovereign software architecture and hardware design, manufacturing and supply chain, CA-1 combines the strength of the European aerospace ecosystem with the continent's deep talent in AI and software engineering. CA-1 will deliver advanced combat capability while strengthening strategic autonomy and supply chain security.","title":"SOVEREIGN"}]},"slide5":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-8fc441d6d54fecc9f17f3209e33e021a028ce3c3-4096x3072-jpg","_type":"reference"}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-509739d55425bba527b47514bb6c7b735b2f5316-1026x1794-jpg","_type":"reference"}},"bulletPoints":[{"_key":"b65eb964da9f","_type":"bulletPointText","label":"Role","text":"Multi-mission"},{"_key":"b1845bef5524","_type":"bulletPointText","label":"Operation","text":"Autonomous"},{"_key":"331386044bca","_type":"bulletPointText","label":"Weapons Bay","text":"Internal"},{"_key":"b214f4d17392","_type":"bulletPointText","label":"Scale","text":"Affordable mass"},{"_key":"63cbd2557606","_type":"bulletPointText","label":"Logistics","text":"Dispersed operations"}]},"slide6":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-ccb51d18bc117f6204a679d2a6614b132e5f2878-2570x3100-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.8290322580645161,"height":3100,"width":2570},"filename":"ccb51d18bc117f6204a679d2a6614b132e5f2878-2570x3100.png","hotspot":null,"lqip":"$1e"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-d237bb632e5a9283a170225ed69bb2753022eb88-1170x2104-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.5560836501901141,"height":2104,"width":1170},"filename":"d237bb632e5a9283a170225ed69bb2753022eb88-1170x2104.png","hotspot":null,"lqip":"$1f"},"bulletPoints":{"landscape":[{"alignRight":true,"growsUp":true,"posX":27,"posY":2,"text":"Length: 11m","width":22},{"alignRight":false,"growsUp":true,"posX":9,"posY":29,"text":"Max Takeoff Weight: 4tn","width":40},{"alignRight":true,"growsUp":true,"posX":1,"posY":42.5,"text":"Wingspan: 10m","width":25},{"alignRight":false,"growsUp":true,"posX":9,"posY":99.5,"text":"Speed: high subsonic","width":38}],"portrait":[{"alignRight":true,"growsUp":true,"posX":11,"posY":4,"text":" Length: 11m","width":25},{"alignRight":false,"growsUp":true,"posX":10,"posY":29.4,"text":"Max Takeoff Weight: 4tn","width":29},{"alignRight":true,"growsUp":true,"posX":6,"posY":39.2,"text":"Wingspan: 10m","width":30},{"alignRight":false,"growsUp":true,"posX":13,"posY":94.8,"text":"Speed: high subsonic","width":28}]},"texts":null},"slide7":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-d7449cc7f5919e7e41c59e99e4b607137a1f7982-2886x1492-jpg","_type":"reference"}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-f49f98566905998360ed42fa44b6aa9e033a3064-4096x3072-jpg","_type":"reference"}},"texts":[{"text":[{"_key":"281369e608b2","_type":"block","children":[{"_key":"323df6c0a2ee","_type":"span","marks":[],"text":"CA-1 Europa development integrates three advanced AI systems addressing critical capability gaps in contested airspace:"}],"markDefs":[],"style":"normal"},{"_key":"cd7342dce455","_type":"block","children":[{"_key":"c8bfc9138a6d","_type":"span","marks":["strong","d1fb1b5a8084"],"text":"Centaur"},{"_key":"2e31e2a73a92","_type":"span","marks":["strong"],"text":" AI for Autonomous Combat"},{"_key":"d1afcaf0879f","_type":"span","marks":[],"text":"\nReinforcement-learning AI agent achieving human-level air combat performance with superior decision-making speed and tactical execution."}],"markDefs":[{"_key":"d1fb1b5a8084","_type":"link","href":"https://helsing.ai/centaur"}],"style":"normal"},{"_key":"68df124ba383","_type":"block","children":[{"_key":"b82283dcb7e9","_type":"span","marks":["strong","c4f26a537e68"],"text":"Cirra"},{"_key":"35b8609ce0bd","_type":"span","marks":["strong"],"text":" for Electronic Warfare"},{"_key":"07321c406db3","_type":"span","marks":[],"text":"\nDeep learning-based EW system countering adaptive, software-defined IADS emitters, restoring EW superiority."}],"markDefs":[{"_key":"c4f26a537e68","_type":"link","href":"https://helsing.ai/cirra"}],"style":"normal"},{"_key":"c27e25e531cf","_type":"block","children":[{"_key":"c54a5c93388e","_type":"span","marks":["strong"],"text":"Symphony for Mission Operations"},{"_key":"26235939cb7c","_type":"span","marks":[],"text":"\nAI platform orchestrating capabilities across distributed assets, enabling rapid mission insights generation andÂ capability updates."}],"markDefs":[],"style":"normal"}],"title":"AI And Software Components"}]}}}]
