5:["$","$L1b",null,{"data":{"seo":{"description":"AI and autonomous swarms to detect subsurface threats and protect critical infrastructure.","ogImage":{"_type":"image","asset":{"_ref":"image-22a06ebc5b3699d3e1d280909b7f6d5ff97b86dd-1200x660-png","_type":"reference"}},"title":"SG-1 + Lura"},"slide1":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-9b121605a7ae17c747a30dccd8fad81550906268-2500x2480-png","_type":"reference"},"crop":{"_type":"sanity.imageCrop","bottom":0.1284304951845223,"left":0,"right":0,"top":0},"hotspot":{"_type":"sanity.imageHotspot","height":0.8715695048154777,"width":1,"x":0.5,"y":0.43578475240773884}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-9b121605a7ae17c747a30dccd8fad81550906268-2500x2480-png","_type":"reference"}},"text1":"SG-1 + Lura\nUnderwater Autonomous Mass"},"slide2":{"text1":"AI and autonomous swarms to detect subsurface threats and protect critical infrastructure."},"slide3":{"text":"SG-1 Fathom redefines subsurface surveillance. Mass manufacturable, hundreds of SG-1s can be deployed at scale to monitor vast underwater areas. Â \nÂ \nCapable of discreetly patrolling in a swarm or holding position on the seabed, the glider operates at depth and throughout the water column. It is resilient and energy efficient, enabling persistent operation.\nÂ \nSG-1 is integrated with Lura to provide real-time detection and classification at the edge: critical in environments where bandwidth is low and data volumes high.Â ","titles":[{"title":"SG-1 Fathom â€“ Subsurface Glider"}],"videoLandscape":{"360":"f7a180229ee9e0046ec1980d1dab1e67ab640391.mp4","720":"f7a180229ee9e0046ec1980d1dab1e67ab640391.mp4","1080":"f7a180229ee9e0046ec1980d1dab1e67ab640391.mp4"},"videoPortrait":{"360":"bd5178c42d1d758fb501f00bee8d7efb8ef698f1.mp4","720":"bd5178c42d1d758fb501f00bee8d7efb8ef698f1.mp4","1080":"bd5178c42d1d758fb501f00bee8d7efb8ef698f1.mp4"}},"slide4":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-4d7d9f937489a049824170d617a2d4a25c03ae90-4762x2723-jpg","_type":"reference"}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-4d7d9f937489a049824170d617a2d4a25c03ae90-4762x2723-jpg","_type":"reference"}},"textBlocks":[{"text":"Built for the underwater battlespace and trained on decades of acoustic data, the Lura software platform transforms underwater surveillance through real-time processing at the edge. Â \nÂ \nOnly a single operator is required, either on shore or vessel, for mission planning, management and analysis of a constellation of SG-1 Fathoms.\nÂ \nAt the core of Lura is a large acoustic model (LAM) which is continuously trained on new data and threat patterns. Lura is an open system, ensuring compatibility from day one.Â ","title":"Lura"}]},"slide5":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-8b7e68aea79100d271d8607d5659ed66a6976b25-4000x2934-jpg","_type":"reference"}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-8b7e68aea79100d271d8607d5659ed66a6976b25-4000x2934-jpg","_type":"reference"}},"text":"SG-1 will be mass produced in Helsing Resilience Factories, enabling sovereign and distributed production capabilities at scale. Its compact design simplifies deployment and recovery from both commercial and military vessels by a lean crew. Â \nÂ \nLura is designed for interoperability and integrates seamlessly across in-service allied platforms and infrastructure. Every mission informs the next with data used to improve capability and sharpen performance, enabling Lura to adapt with the needs of modern navies.","titles":[{"title":"Mission cycle"}]},"slide6":{"bulletPoints":[{"_key":"1c032bd34396","_type":"bulletPointNumber","label":"Length","number":"195","unit":"cm"},{"_key":"4eb18dc5a33b","_type":"bulletPointNumber","label":"Diameter","number":"28","unit":"cm"},{"_key":"cc3182640af6","_type":"bulletPointNumber","label":"Weight","number":"60","unit":"kg"},{"_key":"1e9322e4951e","_type":"bulletPointNumber","label":"Speed","number":"1-2","unit":"kts"},{"_key":"0518fc15141b","_type":"bulletPointNumber","label":"Endurance","number":"3","unit":"months"}],"vector":{"_type":"image","asset":{"_ref":"image-3d106f47b19374afb14c922752e09e1d88ee0ef4-1176x402-svg","_type":"reference"}}},"slide7":{"bgImageLandscape":{"_type":"image","asset":{"_ref":"image-b21f400092ad2b8225ecee4b565780b00e14049a-4000x3000-jpg","_type":"reference"}},"bgImagePortrait":{"_type":"image","asset":{"_ref":"image-b21f400092ad2b8225ecee4b565780b00e14049a-4000x3000-jpg","_type":"reference"},"crop":{"_type":"sanity.imageCrop","bottom":0,"left":0.09257542827921247,"right":0.3984834441319356,"top":0},"hotspot":{"_type":"sanity.imageHotspot","height":1,"width":0.5089411275888519,"x":0.34704599207363845,"y":0.5}}}}}]
