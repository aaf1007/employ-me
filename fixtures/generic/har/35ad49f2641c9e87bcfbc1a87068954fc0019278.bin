1c:T502,data:image/png;base64,:T81e,data:image/png;base64,:["$","$L1b",null,{"data":{"components":{"items":[{"image":{"_type":"image","alt":"","asset":{"_ref":"image-c9f8e4e21728dcf05efde6228d108d6884b762f2-2528x1904-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.3277310924369747,"height":1904,"width":2528},"filename":"c9f8e4e21728dcf05efde6228d108d6884b762f2-2528x1904.png","hotspot":null,"lqip":"$1c"},"text":"Altra Ground Station"},{"image":{"_type":"image","alt":"","asset":{"_ref":"image-5751069f36dc96162efb43a4c23642b044dc330b-2528x664-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":3.8072289156626504,"height":664,"width":2528},"filename":"5751069f36dc96162efb43a4c23642b044dc330b-2528x664.png","hotspot":null,"lqip":"data:image/png;base64,"},"text":"Altra ISR"},{"image":{"_type":"image","alt":"","asset":{"_ref":"image-0efd89725b48a7cbd1b74a5d686d665ba1442e00-1896x516-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":3.6744186046511627,"height":516,"width":1896},"filename":"0efd89725b48a7cbd1b74a5d686d665ba1442e00-1896x516.png","hotspot":null,"lqip":"data:image/png;base64,"},"text":"Altra Strike"},{"image":{"_type":"image","alt":"","asset":{"_ref":"image-bdb716517a0cd32117bb55e38801207d093e2a97-1199x317-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":3.782334384858044,"height":317,"width":1199},"filename":"bdb716517a0cd32117bb55e38801207d093e2a97-1199x317.png","hotspot":null,"lqip":"data:image/png;base64,"},"text":"Altra Indirect Fires"},{"image":{"_type":"image","alt":"","asset":{"_ref":"image-a7780daab824cdb26ab29cae14ab394115f23035-2967x1865-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5908847184986594,"height":1865,"width":2967},"filename":"a7780daab824cdb26ab29cae14ab394115f23035-2967x1865.png","hotspot":null,"lqip":"data:image/png;base64,"},"text":"Future Capabilities"}],"text":"Altra accelerates target identification, localisation, assignment and engagement by combining on-edge AI with a degradation-resilient networking stack and powerful ground station software.Â \n\nLive data streams from ISR drones, spotters and other sources are integrated into a common operational target picture on ground stations and handheld devices.Â AI-aided effector assignments â€“ surfaced through an intuitive human-machine interface â€“ reduce load on the operator.Â \n\nThrough Altra ground station, operators coordinate and adapt scaled campaigns in real-time, orchestrating indirect fires and strike drone swarms for controlled time-on-target and saturation attacks.Â For indirect fires, automated fire adjustment speeds up the decision chain and reduces operator load in battle.Â ","title1":"Components","title2":"A 10x Force MultiplierÂ "},"hero":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-9a3c4b08f03a5ef644b95bad1875af4f39acdc9a-4000x2354-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.699235344095157,"height":2354,"width":4000},"filename":"9a3c4b08f03a5ef644b95bad1875af4f39acdc9a-4000x2354.png","hotspot":null,"lqip":"data:image/png;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-9a3c4b08f03a5ef644b95bad1875af4f39acdc9a-4000x2354-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.699235344095157,"height":2354,"width":4000},"filename":"9a3c4b08f03a5ef644b95bad1875af4f39acdc9a-4000x2354.png","hotspot":null,"lqip":"data:image/png;base64,"},"text":"Altra\nRecce-Strike Software Platform"},"integration":{"text":"Open interfaces ensure robust integration into in-service and future platforms. Existing integrations include the main European artillery systems and mortar launchers, RC weapon stations, ISR drones and strike drones.Â \n\nHelsingâ€™s software-defined strike drone HX-2 is natively integrated with Altra.Â ","title":"Integration"},"intro":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-4ea02fef4d183646bc76fcb3e38c94225c13cd0a-3776x2023-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.8665348492338112,"height":2023,"width":3776},"filename":"4ea02fef4d183646bc76fcb3e38c94225c13cd0a-3776x2023.png","hotspot":null,"lqip":"data:image/png;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-4d4fbc36948a3696a360c62b4c6cc89518964435-1757x2440-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.7200819672131148,"height":2440,"width":1757},"filename":"4d4fbc36948a3696a360c62b4c6cc89518964435-1757x2440.png","hotspot":null,"lqip":"$1d"},"text":"Altra intelligently connects all elements of the battlefield to transform the accuracy, speed and robustness of modern land forces. Altra uses AI to achieve scaled target acquisition and coordinated precision effects.Â \n\nDrones and ISR assets gain the ability to penetrate heavily contested Electromagnetic Warfare (EW) environments while allowing artillery systems and other effectors to engage targets with superior hit rates.","title":"LAND COMBAT AT AI SPEED"},"keyProperties":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-4487b3318add825f1334e81e67a6b5b74091128b-3840x2400-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6,"height":2400,"width":3840},"filename":"4487b3318add825f1334e81e67a6b5b74091128b-3840x2400.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-4487b3318add825f1334e81e67a6b5b74091128b-3840x2400-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6,"height":2400,"width":3840},"filename":"4487b3318add825f1334e81e67a6b5b74091128b-3840x2400.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"items":[{"text":"Software-defined Recce-Strike complexÂ "},{"text":"AI mission planning and command and control of swarming autonomous systems"},{"text":"Edge AI modules for end-to-end autonomous missions in contested environments"},{"text":"Open interfaces for integrating third-party C2 systems and hardware platforms"},{"text":"Automated fires correction for artilleryÂ "},{"text":"AI sensor fusion and real-time common operational picture"},{"text":"Distributed data fabric for resilientÂ comms over degraded networks"}],"title":"Key Properties"},"seo":{"description":"Artificial intelligence to protect our democracies.","ogImage":{"_type":"image","asset":{"_ref":"image-072bf16e5dcd3153e8f8f2795aa5996da45277fe-1200x660-png","_type":"reference"}},"title":"Altra"}}}]
