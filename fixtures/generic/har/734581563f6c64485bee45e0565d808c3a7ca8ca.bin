1c:T616,data:image/png;base64,:T892,data:image/png;base64,:T892,data:image/png;base64,:T1542,data:image/png;base64,:T1542,data:image/png;base64,:["$","$L1b",null,{"data":{"altra":{"mediaImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-9957a469eb9386d6bad2ac8be87891ef8cba2056-3000x2000-jpg","_type":"reference"},"crop":{"_type":"sanity.imageCrop","bottom":0,"left":0,"right":0,"top":0},"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5,"height":2000,"width":3000},"filename":"9957a469eb9386d6bad2ac8be87891ef8cba2056-3000x2000.jpg","hotspot":{"_type":"sanity.imageHotspot","height":1,"width":1,"x":0.5,"y":0.5},"lqip":"data:image/jpeg;base64,"},"mediaImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-cb40163183f7e3fc1c04fd62f547b5e11b8602e0-750x1602-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.4681647940074906,"height":1602,"width":750},"filename":"cb40163183f7e3fc1c04fd62f547b5e11b8602e0-750x1602.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"mediaType":"image","mediaVideoLandscape":null,"mediaVideoPortrait":null,"text":"Contra runs on Altra, Helsing's military AI and C2 platform. With Altra as the foundation, users retain full control over decision making and prioritisation. Altra fuses radar, electro-optical, infrared, and acoustic feeds from any vendor's sensors through open, published interfaces, and connects to SitaWare and national battle management systems. Contra is designed to operate through jamming, severed links, and lost nodes.","title":"Altra"},"hero":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-c58c4bb1615da1ffb1f3954fbbf13e5297b51e7a-3840x2405-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5966735966735968,"height":2405,"width":3840},"filename":"c58c4bb1615da1ffb1f3954fbbf13e5297b51e7a-3840x2405.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-d433115a53504ae8b725658c1f82a02989ccb457-1024x2185-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.46864988558352405,"height":2185,"width":1024},"filename":"d433115a53504ae8b725658c1f82a02989ccb457-1024x2185.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"fgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-3a951804a92a923762f3169e08e7c5ce13028358-3840x2405-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5966735966735968,"height":2405,"width":3840},"filename":"3a951804a92a923762f3169e08e7c5ce13028358-3840x2405.png","hotspot":null,"lqip":"data:image/png;base64,"},"fgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-d763c8f56cd5acc601e6dec568b551f1a0ed43f3-1024x2185-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.46864988558352405,"height":2185,"width":1024},"filename":"d763c8f56cd5acc601e6dec568b551f1a0ed43f3-1024x2185.png","hotspot":null,"lqip":"$1c"},"title":{"_type":"image","alt":"","asset":{"_ref":"image-e0d3a240c18f61bb4ce1b3c416d559c785341e48-382x92-svg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":4.1521739130434785,"height":92,"width":382},"filename":"e0d3a240c18f61bb4ce1b3c416d559c785341e48-382x92.svg","hotspot":null,"lqip":"data:image/png;base64,"},"titleOffsetLandscape":26.9,"titleOffsetPortrait":34.6,"titleWidthLandscape":22,"titleWidthPortrait":62},"intro":{"text":"Contra is an autonomous air defence system featuring two new interceptors, AD-1 Inferno and AD-2 Ambush. It allows the detection and engagement of hundreds or thousands of drone and missile threats at the same time by fusing sensors and effectors into a single air picture and executing engagement decisions autonomously under meaningful human control.\n\nThe system is natively set up to integrate third-party hardware, such as other interceptors, cUAV lasers, cUAV guns, or net-based systems.\n\nContra is capable of defending against saturation attacks, missiles, and attack drones of the latest generation.","title":"Autonomous Fire Dominance Against Aerial Threats"},"missions":{"description":"The same system runs in every mission. The sensor and effector mix changes with the threat and the terrain.","items":[{"_key":"9d96ce113f11","description":"Civilian populations in cities, linked to national air defence.","image":{"_type":"image","alt":"","asset":{"_ref":"image-621584e8aff5b53f4a491dcb9f996f6c206fd8de-2400x1357-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7686072218128224,"height":1357,"width":2400},"filename":"621584e8aff5b53f4a491dcb9f996f6c206fd8de-2400x1357.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"title":"Population centre"},{"_key":"89d8bd618e18","description":"Areas bordering adversary territory with heightened threat.","image":{"_type":"image","alt":"","asset":{"_ref":"image-f3d7816faa31d4d312a5e6952540f7358cd192b2-2400x1357-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7686072218128224,"height":1357,"width":2400},"filename":"f3d7816faa31d4d312a5e6952540f7358cd192b2-2400x1357.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"title":"Borders"},{"_key":"51c4cd3aa4ce","description":"Brigades deployed near the front line, and in the homeland.","image":{"_type":"image","alt":"","asset":{"_ref":"image-37584def81ca97abd4b28a18a276c72c516a7979-2400x1357-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7686072218128224,"height":1357,"width":2400},"filename":"37584def81ca97abd4b28a18a276c72c516a7979-2400x1357.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"title":"Military bases"},{"_key":"5219754ff77a","description":"Troop protection for units on the move, engaging on the march.","image":{"_type":"image","alt":"","asset":{"_ref":"image-63e658165007f9069f6b33b249e5bef803cf8718-2400x1357-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7686072218128224,"height":1357,"width":2400},"filename":"63e658165007f9069f6b33b249e5bef803cf8718-2400x1357.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"title":"Manoeuvring forces"}],"title":"One system, multiple missions, hardware-agnostic"},"productInAction1":{"mediaImageLandscape":null,"mediaImagePortrait":null,"mediaType":"video","mediaVideoLandscape":{"_id":"file-1ea6a23102c44a6faa166b917606fd74561f3db4-mp4","filename":"1ea6a23102c44a6faa166b917606fd74561f3db4.mp4","mimeType":"video/mp4"},"mediaVideoPortrait":{"_id":"file-30ab2792560337f15459044a17397f016ee1e886-mp4","filename":"30ab2792560337f15459044a17397f016ee1e886.mp4","mimeType":"video/mp4"}},"productInAction2":{"mediaImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-3b677c36187cec22c2b2a6e54dbefd53efa379bf-2877x1688-jpg","_type":"reference"},"crop":{"_type":"sanity.imageCrop","bottom":0,"left":0,"right":0,"top":0},"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7043838862559242,"height":1688,"width":2877},"filename":"3b677c36187cec22c2b2a6e54dbefd53efa379bf-2877x1688.jpg","hotspot":{"_type":"sanity.imageHotspot","height":0.39229893681891087,"width":0.6321036744876517,"x":0.6045532917152286,"y":0.4714733050577531},"lqip":"data:image/jpeg;base64,"},"mediaImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-28d18feb78a3d41b6467bb00e06219b532369aef-750x800-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.9375,"height":800,"width":750},"filename":"28d18feb78a3d41b6467bb00e06219b532369aef-750x800.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"mediaType":"image","mediaVideoLandscape":null,"mediaVideoPortrait":null},"productInAction3":{"mediaImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-ae8b54238c43062f714943bce849fbc8529807fc-2878x1742-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6521239954075775,"height":1742,"width":2878},"filename":"ae8b54238c43062f714943bce849fbc8529807fc-2878x1742.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"mediaImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-6cf5021c766a492d79604758f07d40d727aac706-750x1600-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.46875,"height":1600,"width":750},"filename":"6cf5021c766a492d79604758f07d40d727aac706-750x1600.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"mediaType":"image","mediaVideoLandscape":null,"mediaVideoPortrait":null},"radar":{"mediaImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-fb99720e419edf3e508dad55b78075beacfa2c91-2872x1906-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5068205666316894,"height":1906,"width":2872},"filename":"fb99720e419edf3e508dad55b78075beacfa2c91-2872x1906.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"mediaImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-76f4735b4817664090c6a472263b92486253b458-750x800-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.9375,"height":800,"width":750},"filename":"76f4735b4817664090c6a472263b92486253b458-750x800.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"mediaType":"image","mediaVideoLandscape":null,"mediaVideoPortrait":null,"text":"Most affordable seekers rely on electro-optical (EO) or infrared (IR) cameras. EO cameras cannot reliably track targets in darkness, and neither perform in cloudy or foggy weather. The radar seekers on AD-1 and AD-2 see through them, built simply from commercial off the-shelf components.       \n\nTerminal acquisition is a system-level problem. AI optimises the interceptor's trajectory to maximise the probability of success.","title":"Helsingâ€™s AI-enhanced radar seeker"},"seo":{"description":"","ogImage":{"_type":"image","asset":{"_ref":"image-d8409122da56b5b99730f69498764388cd04b7ec-1200x660-jpg","_type":"reference"}},"title":"Contra"},"specs":{"ad1":{"description":"AD-1 is a jet-powered interceptor, designed to bridge the gap where electric effectors are kinematically outmatched and legacy missile systems cost too much to deploy at scale.\n\nAD-1 launches at first detection and receives mid-course guidance from Contra radar ground stations. It can loiter, swarm, and re-engage in flight. Designed for European sovereign production at scale, it restores the cost-exchange ratio in the defender's favour. AD-1 integrates natively into Contra.","imageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-9964e2a3f7960e35e01ea7b1b01c1abbba3b50b8-1130x1937-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.5833763551884358,"height":1937,"width":1130},"filename":"9964e2a3f7960e35e01ea7b1b01c1abbba3b50b8-1130x1937.png","hotspot":null,"lqip":"$1d"},"imagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-9964e2a3f7960e35e01ea7b1b01c1abbba3b50b8-1130x1937-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.5833763551884358,"height":1937,"width":1130},"filename":"9964e2a3f7960e35e01ea7b1b01c1abbba3b50b8-1130x1937.png","hotspot":null,"lqip":"$1e"},"specs":[{"_key":"f53e7d55bae8","key":"Propulsion","value":"Jet"},{"_key":"367ad0aea300","key":"Operating conditions","value":"All-weather"},{"_key":"1e9d0079d025","key":"Maximum speed","value":"> 700 km/h"},{"_key":"3372c544d249","key":"Maximum range","value":"â‰¥ 20 km"},{"_key":"2070e182f5c7","key":"Operating altitude","value":"> 9,000 m"},{"_key":"ca9be428bb35","key":"Launch","value":"Containerised"}],"title":"AD-1 Inferno\nJet-powered interceptor"},"ad2":{"description":"AD-2 is a solid-rocket-motor interceptor designed for rapid intercepts at the upper edge of the threat envelope. It defeats high-speed, high-altitude one-way attack drones and subsonic cruise missiles beyond AD-1's reach.\n\nDesigned for mass production on a supply chain separate from AD-1, it lets defenders sustain high-volume engagements without depending on a single production line. AD-2 integrates natively into Contra and receives mid-course guidance from Contra radar ground stations.","imageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-14b13da1d328fe7e40c9a06ea26d810c3e05ec18-823x4498-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.1829702089817697,"height":4498,"width":823},"filename":"14b13da1d328fe7e40c9a06ea26d810c3e05ec18-823x4498.png","hotspot":null,"lqip":"$1f"},"imagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-14b13da1d328fe7e40c9a06ea26d810c3e05ec18-823x4498-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.1829702089817697,"height":4498,"width":823},"filename":"14b13da1d328fe7e40c9a06ea26d810c3e05ec18-823x4498.png","hotspot":null,"lqip":"$20"},"specs":[{"_key":"7ed869aa5832","key":"Propulsion","value":"Solid rocket"},{"_key":"9554c6fc9177","key":"Operating conditions","value":"All-weather"},{"_key":"9af4096339ae","key":"Maximum speed","value":"> Mach 2"},{"_key":"aa259067f027","key":"Maximum range","value":"â‰¥ 20 km"},{"_key":"81e486981232","key":"Operating altitude","value":"> 9,000 m"},{"_key":"b1806f13e656","key":"Launch","value":"Containerised"}],"title":"AD-2 Ambush\nRocket-powered interceptor"}}}}]
