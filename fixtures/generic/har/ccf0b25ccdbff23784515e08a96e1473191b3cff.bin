1c:T48e,data:image/png;base64,:T48e,data:image/png;base64,:T48a,data:image/png;base64,:T9d6,data:image/png;base64,:T7e6,data:image/png;base64,:["$","$L1b",null,{"data":{"block1":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-67699384f2a15e24ef42bebbaee27890ff91f296-4006x3004-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.333555259653795,"height":3004,"width":4006},"filename":"67699384f2a15e24ef42bebbaee27890ff91f296-4006x3004.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-67699384f2a15e24ef42bebbaee27890ff91f296-4006x3004-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.333555259653795,"height":3004,"width":4006},"filename":"67699384f2a15e24ef42bebbaee27890ff91f296-4006x3004.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"text":"Strengthening NATO and European Sovereign Defence Manufacturing\n\nResilience Factories are a new type of high-efficiency production facility, designed to ensure local and sovereign manufacturing capabilities for nation states. Helsing is building Resilience Factories across the European continent, thereby unlocking distributed production capacities for critical defence assets, with each location gaining the ability to source from local supply chains and workforces.","title":"resilience factories"},"block2":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-526a484dacea6b983419d75ebdf6676c1a06303f-2880x1750-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6457142857142857,"height":1750,"width":2880},"filename":"526a484dacea6b983419d75ebdf6676c1a06303f-2880x1750.png","hotspot":null,"lqip":"$1c"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-526a484dacea6b983419d75ebdf6676c1a06303f-2880x1750-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6457142857142857,"height":1750,"width":2880},"filename":"526a484dacea6b983419d75ebdf6676c1a06303f-2880x1750.png","hotspot":null,"lqip":"$1d"},"text":"RF-1, Helsing's first Resilience Factory, was completed in December 2024 and is situated in Southern Germany. RF-1 has an initial monthly production capacity of more than 1000 HX-2s.\n\nRF-2 (with higher production volume) is presently in the planning phase.","title1":"High-Throughput","title2":"Distributed","title3":"Sovereign"},"block3":{"image1":{"_type":"image","alt":"","asset":{"_ref":"image-36d0b60ab5ad5e0bed8b6cf8ca753da5ea136896-1920x1440-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.3333333333333333,"height":1440,"width":1920},"filename":"36d0b60ab5ad5e0bed8b6cf8ca753da5ea136896-1920x1440.png","hotspot":null,"lqip":"$1e"},"image2":{"_type":"image","alt":"","asset":{"_ref":"image-63e098e1b5fafa0578bbd61f25eacb7f809a94a3-1248x1683-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.7415329768270945,"height":1683,"width":1248},"filename":"63e098e1b5fafa0578bbd61f25eacb7f809a94a3-1248x1683.png","hotspot":null,"lqip":"$1f"},"image3":{"_type":"image","alt":"","asset":{"_ref":"image-4dc582ce6ae7f5133298c4a7a8dc08dce103ca94-8736x11648-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.75,"height":11648,"width":8736},"filename":"4dc582ce6ae7f5133298c4a7a8dc08dce103ca94-8736x11648.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"text":"HX-2 and Resilience Factories have been designed with high throughput and scale from the outset. Through the systematic choice of components, materials and manufacturing techniques, HX-2 can be produced in volumes that are unprecedented for modern autonomous drones. In both system and manufacturing design, complexity of hardware has been absorbed by software, thereby drastically reducing the number of components and assembly steps.","title":"Mass-production of HX-2"},"hero":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-d8e55446fbc70350770ca62a2eb4672aa2e4a94b-1920x1276-jpg","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5047021943573669,"height":1276,"width":1920},"filename":"d8e55446fbc70350770ca62a2eb4672aa2e4a94b-1920x1276.jpg","hotspot":null,"lqip":"data:image/jpeg;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-40335c660016ca95676f45d51313ec140c685789-375x671-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.5588673621460507,"height":671,"width":375},"filename":"40335c660016ca95676f45d51313ec140c685789-375x671.png","hotspot":null,"lqip":"$20"},"text":"Resilience Factories\nMass Defence Manufacturing"},"intro":{"text":"The changed geopolitical landscape requires a new approach to defence manufacturing. The conflict in Ukraine has exposed a critical need for sovereign and distributed production capabilities at scale across Europe and NATO, especially for intelligent mass like UAVs and precision munitions.","title1":"Sovereign\nproduction","title2":"Distributed\nScale"},"outro":{"bgImageLandscape":{"_type":"image","alt":"","asset":{"_ref":"image-f9297d2368775cd49f6a5fa6b25b4d7dc88d2189-2880x1632-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7647058823529411,"height":1632,"width":2880},"filename":"f9297d2368775cd49f6a5fa6b25b4d7dc88d2189-2880x1632.png","hotspot":null,"lqip":"data:image/png;base64,"},"bgImagePortrait":{"_type":"image","alt":"","asset":{"_ref":"image-f9297d2368775cd49f6a5fa6b25b4d7dc88d2189-2880x1632-png","_type":"reference"},"crop":null,"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7647058823529411,"height":1632,"width":2880},"filename":"f9297d2368775cd49f6a5fa6b25b4d7dc88d2189-2880x1632.png","hotspot":null,"lqip":"data:image/png;base64,"}},"seo":{"description":"Artificial intelligence to protect our democracies.","ogImage":{"_type":"image","asset":{"_ref":"image-67adfc4705a3914fd4d77b4c3155647493c1507a-1200x660-png","_type":"reference"}},"title":"Resilience Factories"}}}]
