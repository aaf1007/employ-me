{
  "name": "employ-me",
  "version": "0.0.0",
  "private": true,
  "description": "Local helper for the employ-me Chrome extension. Runs your own claude or codex CLI over Chrome Native Messaging.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "employ-me": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@employ-me/core": "workspace:*",
    "tsdown": "0.23.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  }
}
