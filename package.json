{
  "name": "employ-me-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "build": "pnpm -r build",
    "setup:local": "pnpm build && node packages/helper/dist/cli.mjs setup --extension packages/extension/.output/chrome-mv3",
    "smoke:providers": "vitest run --config packages/helper/vitest.smoke.config.ts",
    "format": "prettier --write . && eslint . --fix",
    "fill-rate": "node tools/fill-rate.ts"
  },
  "devDependencies": {
    "@employ-me/core": "workspace:*",
    "@employ-me/fill": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
